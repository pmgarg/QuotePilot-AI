# QuotePilot AI — environment template. Placeholders only. NEVER commit real secrets.
APP_ENV=development                      # development | test | staging | production
SECRET_KEY=change-me-to-a-random-64-char-string-change-me-to-a-random-64-char
LOG_LEVEL=INFO

# PostgreSQL: the API runs as the non-owner role (RLS enforced); migrations run as the owner role.
DATABASE_URL=postgresql+psycopg://quotepilot_app:quotepilot_app@localhost:5432/quotepilot
DATABASE_ADMIN_URL=postgresql+psycopg://quotepilot_owner:quotepilot_owner@localhost:5432/quotepilot
# Used by scripts/db_setup.sh when creating roles locally
QP_OWNER_PASSWORD=quotepilot_owner
QP_APP_PASSWORD=quotepilot_app

# Web → API proxy target (Next.js rewrites /api/* to this origin)
API_INTERNAL_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=                           # empty = derived from APP_ENV (secure outside development/test)

# Private file storage
STORAGE_BACKEND=local                    # local | s3 (s3 requires `uv sync --extra s3`)
STORAGE_DIR=./var/storage
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=

# Limits
MAX_UPLOAD_BYTES=10485760
PARSE_TIMEOUT_SECONDS=20
MATCH_TIMEOUT_SECONDS=8                  # wall clock for one batch of fuzzy matching (worker process)
RFQ_PARSE_RATE_LIMIT_ATTEMPTS=30         # per user per window: RFQ create (file/text) and re-parse
CATALOG_IMPORT_RATE_LIMIT_ATTEMPTS=10    # per user per window: catalog imports
EXPENSIVE_RATE_LIMIT_WINDOW_SECONDS=300

# Optional AI provider (OFF by default; enabling may incur third-party charges — requires owner consent)
AI_PROVIDER=disabled                     # disabled | anthropic
ANTHROPIC_API_KEY=                       # server-side only; never expose to the browser
AI_MODEL=claude-opus-5-5

# Demo seed password (local only, ≥ 12 chars). Required for `make demo` and the Compose `migrate` service: the seed
# refuses to run without it and never prints or generates a password.
DEMO_PASSWORD=

# Stage 2 — follow-up assistant
TOKEN_ENCRYPTION_KEY=                    # base64 of 32 random bytes; required to store provider secrets
MAIL_PROVIDER_DEFAULT=simulator          # simulator | smtp (no e-mail leaves the system with the simulator)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=
FOLLOWUP_WORKER_ID=worker-1

# --- Stage 3: customer & order intelligence ---
STOCK_STALE_AFTER_HOURS=24      # stock snapshots older than this are labelled "stale"
RETENTION_GRACE_DAYS=30         # soft-deleted customer data is purged by the worker after this many days
MAX_IMPORT_ROWS=10000           # CSV import row cap (customers / orders)
MAX_SYNC_RECORDS=5000           # records per connector sync push
